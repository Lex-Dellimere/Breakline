_build/
deps/
*.ez
erl_crash.dump

# node
node_modules/

# editors and os
.elixir_ls/
.lexical/
.DS_Store

# agent worktrees
.claude/worktrees/

# full-stack check: generated pki, secrets, ids and recordings (e2e/README.md)
/e2e/.run/
