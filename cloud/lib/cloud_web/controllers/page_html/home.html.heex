<Layouts.app flash={@flash} current_user={assigns[:current_user]}>
  <section class="space-y-6 py-8">
    <.badge color="primary" variant="bordered" rounded="full" size="small">
      control plane
    </.badge>
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
      Remote access stays closed until you open it.
    </h1>
    <p class="max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
      Breakline is a client-owned gateway in front of your MSP's remote-access channel.
      The channel opens only inside a booked window or after a client approver says yes.
    </p>
    <div class="flex flex-wrap gap-3">
      <%= if assigns[:current_user] do %>
        <.button_link href={~p"/sign-out"} variant="bordered" color="natural">
          Sign out
        </.button_link>
      <% else %>
        <.button_link
          href={~p"/register"}
          variant="default"
          color="primary"
          icon="hero-arrow-right"
        >
          Create an account
        </.button_link>
        <.button_link href={~p"/sign-in"} variant="bordered" color="natural">
          Sign in
        </.button_link>
      <% end %>
    </div>
  </section>

  <section class="grid gap-4 sm:grid-cols-3">
    <.card
      :for={
        {icon, title, body} <- [
          {"hero-calendar-days", "Booked windows",
           "Schedule maintenance windows ahead of time; access opens and closes on the clock."},
          {"hero-hand-raised", "Approver in the loop",
           "Ad-hoc sessions wait for an explicit yes from a client approver."},
          {"hero-lock-closed", "Closed by default",
           "Outside a window or approval, the remote-access channel stays shut."}
        ]
      }
      variant="bordered"
      color="natural"
      rounded="large"
      padding="large"
    >
      <.card_title title={title} icon={icon} size="small" font_weight="font-semibold" />
      <.card_content>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">{body}</p>
      </.card_content>
    </.card>
  </section>
</Layouts.app>
