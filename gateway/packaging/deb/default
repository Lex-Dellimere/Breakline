# /etc/default/breakline-gateway: configuration for the breakline site gateway.
#
# read by systemd (EnvironmentFile= in breakline-gateway.service) and by the
# breakline-gateway command. keep to plain KEY=value lines: no quotes, no spaces,
# no shell. restart after a change:
#
#   systemctl restart breakline-gateway
#
# see /usr/share/doc/breakline-gateway/PILOT.md for the install modes, and
# examples/ next to it for each mode's network config.

# required. the site this box enforces for, exactly as the cloud names it.
#BREAKLINE_SITE_ID=

# required. the cloud's policy signing keys the box trusts, comma separated
# key_id=public_key pairs (base64url ed25519), e.g. cloud-1=AbCd...
#BREAKLINE_PUBLIC_KEYS=

# required. the lan-side interfaces whose clients get their dns redirected to this
# box, comma separated. dns-only: the one nic (e.g. enp1s0). bridge: br0. router:
# the nic facing the protected segment.
#BREAKLINE_LAN_INTERFACES=enp1s0

# optional. upstream resolvers, comma separated, port defaults to 53. ipv6 with a
# port is written [addr]:port. without it the gateway uses 1.1.1.1 and 9.9.9.9.
#BREAKLINE_UPSTREAMS=1.1.1.1,9.9.9.9

# optional. monitor (default) logs what it would block and blocks nothing; enforce
# blocks. a signed policy from the cloud sets the mode once one arrives. pilots
# start in monitor.
BREAKLINE_DEFAULT_MODE=monitor

# optional. the address the dns resolver binds on port 53, default 0.0.0.0.
# dns-only: set it to the box's lan address (the one dhcp hands out as dns).
#BREAKLINE_DNS_IP=192.168.1.53

# optional. the cloud uplink. without BREAKLINE_UPLINK_URL the box runs offline and
# only enforces what it already has. with it, the three pem paths are required.
# the paths below are examples: use the ones `breakline-gateway enroll` reports.
#BREAKLINE_UPLINK_URL=wss://cloud.example/gateway/socket/websocket
#BREAKLINE_UPLINK_CERT=/var/lib/breakline/uplink/cert.pem
#BREAKLINE_UPLINK_KEY=/var/lib/breakline/uplink/key.pem
#BREAKLINE_UPLINK_CA=/var/lib/breakline/uplink/ca.pem
# optional. the name the cloud's certificate carries, when it isn't the url's host.
#BREAKLINE_UPLINK_SERVER_NAME=

# BREAKLINE_DATA_DIR is fixed at /var/lib/breakline by the service (StateDirectory=),
# where the signed policy, the verifier state and the audit chain live. don't set it
# here.
