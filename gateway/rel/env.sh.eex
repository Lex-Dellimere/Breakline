#!/bin/sh

# distribution is only for `bin/gateway rpc` on the box itself (the status command).
# the node is named on loopback, listens on 127.0.0.1 only (vm.args) and needs no
# epmd. see "release and pilot box" in the gateway readme.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=gateway@127.0.0.1

# the cookie is per box, written at install time and readable only by the service
# user. the package ships without the build-time cookie, so there is no fallback.
if [ -z "$RELEASE_COOKIE" ] && [ "$RELEASE_COMMAND" != "version" ]; then
  cookie_file="${BREAKLINE_COOKIE_FILE:-/etc/breakline-gateway/cookie}"

  if [ -r "$cookie_file" ]; then
    RELEASE_COOKIE="$(cat "$cookie_file")"
    export RELEASE_COOKIE
  else
    echo "ERROR: cannot read the erlang cookie at $cookie_file" >&2
    exit 1
  fi
fi
